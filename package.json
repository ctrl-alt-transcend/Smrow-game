{
	"private": "true",
	"scripts": {
		"prepare": "husky"
	},
	"devDependencies": {
	"husky": "^9.1.7",
	"lint-staged": "^17.6.0"
	},
	"lint-staged": {
    "app/frontend/**/*.{ts,tsx,js,jsx}": [
      "cd app/frontend/ && prettier --write",
      "cd app/frontend/ && oxlint --fix",
      "cd app/frontend/ && oxlint"
    ],
    "app/backend/**/*.{ts,tsx,js,jsx}": [
      "cd app/backend/ && prettier --write",
      "cd app/backend/ && eslint --fix",
      "cd app/backend/ && eslint"
    ]
  }
}
