{
	"name": "Catan",
	"private": true,
	"workspaces": [
		"shared",
		"backend",
		"frontend"
	],
	"scripts": {
		"build:shared": "npm run build -w shared",
		"prepare": "cd ../ && husky app/.husky"
	},
	"allowScripts": {
		"bcrypt": true,
		"@parcel/watcher": true,
		"prisma": true,
		"@prisma/engines": true,
		"unrs-resolver": true
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0"
	},
	"lint-staged": {
		"./frontend/**/*.{ts,tsx,js,jsx}": [
			"cd ./frontend/ && prettier --write",
			"cd ./frontend/ && oxlint --fix",
			"cd ./frontend/ && oxlint"
		],
		"./backend/**/*.{ts,tsx,js,jsx}": [
			"cd ./backend/ && prettier --write",
			"cd ./backend/ && eslint --fix",
			"cd ./backend/ && eslint"
		]
	}
}
