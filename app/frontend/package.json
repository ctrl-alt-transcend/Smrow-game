{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host '0.0.0.0' --config config/vite.config.ts",
    "build": "tsc -b config/tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "type-check": "tsc -b config/tsconfig.json --noEmit",
    "clean": "rm -rf dist node_modules/.tmp",
    "test": "vitest run --config config/vite.config.ts",
    "test:watch": "vitetest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "oxlint --fix",
      "oxlint"
    ]
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@tabler/icons-react": "^3.48.0",
    "@tiptap/extension-link": "^3.31.3",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "prettier": "^3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hexgrid": "^2.0.1",
    "react-router": "^8.4.0",
    "shared": "*",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  }
}
