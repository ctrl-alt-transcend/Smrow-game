{
  "name": "shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "default": "./dist/game/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"./**/*.ts\" \"./**/*.js\""
  },
  "dependencies": {
    "prettier": "^3.9.10",
    "zod": "^4.0.0"
  }
}
