// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

model User {
	id			String @default(cuid()) @id
	username	String @unique
	name		String
	email		String @unique
	createdAt	DateTime @default(now())
	updatedAt	DateTime @updatedAt

		// relations
	profile			Profile?
	localAuth		UserAuth?
	accounts		Account[]
	gamesHistory	GamesPlayer[]
}

model Profile {
	id			String @default(cuid()) @id
	bio			String?
	avatarURL	String?
	user User	@relation(fields: [userId], references: [id], onDelete: Cascade)
	userId		String @unique
	createdAt	DateTime @default(now())
	updatedAt	DateTime @updatedAt
}

model UserAuth {
	id				String @default(cuid()) @id
	passwordHash	String
	user			User @relation(fields: [userId], references: [id], onDelete: Cascade)
	userId			String @unique
}

// OAuth models needed Account & Sessions
model Account {
	userId				String
	provider			String
	providerAccountId	String

		// optional fields
	refresh_token		String?
	access_token		String?
	expires_at			Int?
	token_type			String?
	scope				String?
	id_token			String?
	session_state		String?

	createdAt			DateTime @default(now())
	updatedAt			DateTime @updatedAt

	user				User @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@id([provider, providerAccountId])
}


model Games {
	id			String @default(cuid()) @id
	totalTurns	Int
	duration	Int?
	playedAt	DateTime @default(now())
	players		GamesPlayer[]
}

model GamesPlayer {
	gameId				String
	userId				String

	turnOrder			Int
	winPoints			Int
	isWinner			Boolean
	playerRank			Int

	settlementBuilt		Int
	citiesBuilt			Int
	devCardsBought		Int


	user				User  @relation(fields: [userId], references: [id], onDelete: Cascade)
	games				Games @relation(fields: [gameId], references: [id], onDelete: Cascade)

	@@id([gameId, userId])

	@@unique([gameId, turnOrder])
}
